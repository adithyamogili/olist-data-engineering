# Local-only credentials. Change these before sharing or deploying.
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=olist
WAREHOUSE_USER=olist
WAREHOUSE_PASSWORD=change_me_local_only
WAREHOUSE_DB=olist
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
# Optional AWS S3 archive. Leave S3_BUCKET blank for local-only execution.
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=olist/bronze/source_files
# Optional S3-compatible endpoint for MinIO/local testing.
S3_ENDPOINT_URL=
